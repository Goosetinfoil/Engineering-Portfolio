<style>
  :root{
    --bg:#0B1220; --panel:#0F1B2E; --panel-2:#12213A; --line:#274063;
    --accent:#E8A33D; --accent-dim:#8a672a; --blue:#5B9BD5;
    --text:#E8ECF1; --muted:#8A97A8; --radius:2px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background-color:var(--bg); color:var(--text);
    font-family:'Inter', sans-serif; line-height:1.6;
    background-image:linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size:48px 48px; background-attachment:fixed;
  }
  body::before{
    content:""; position:fixed; inset:0;
    background:radial-gradient(ellipse at 20% 0%, rgba(11,18,32,0.2), var(--bg) 65%);
    pointer-events:none; z-index:0;
  }
  a{color:inherit; text-decoration:none;}
  h1,h2,h3,h4{font-family:'Space Grotesk', sans-serif;}
  ::selection{ background:rgba(232,163,61,0.3); }

  .wrap{ display:grid; grid-template-columns:340px 1fr; min-height:100vh; position:relative; z-index:1; }
  @media (max-width:900px){ .wrap{ grid-template-columns:1fr; } .nav-links{ display:none !important; } main{ padding:40px 24px 80px !important; } .sidebar{ position:relative !important; height:auto !important; border-right:none !important; border-bottom:1px solid var(--line); } }

  /* ---------- Sidebar ---------- */
  .sidebar{ background:var(--panel); border-right:1px solid var(--line); padding:40px 32px; position:sticky; top:0; height:100vh; overflow-y:auto; }
  .eyebrow{ font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:0.12em; color:var(--accent); text-transform:uppercase; display:flex; align-items:center; gap:8px; margin-bottom:18px; }
  .eyebrow::before{ content:""; width:16px; height:1px; background:var(--accent); display:inline-block; }

  .headshot{
    width:160px; height:160px; border-radius:50%; margin-bottom:18px;
    background:linear-gradient(135deg, var(--panel-2), var(--accent-dim));
    border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    font-family:'Space Grotesk', sans-serif; font-size:44px; font-weight:600; color:var(--accent);
    object-fit:cover;
  }
  /* Once you have a photo, replace the <div class="headshot"> below with:
     <img class="headshot" src="headshot.jpg" alt="Bhaskar Sikri"> */

  .name-row{ display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:6px; }
  .name-row h1{ font-size:26px; font-weight:600; white-space:nowrap; }
  .icon-links{ display:flex; align-items:center; gap:4px; }
  .icon-links a{
    width:26px; height:26px; display:flex; align-items:center; justify-content:center;
    color:var(--muted); transition:color .15s;
  }
  .icon-links a:hover{ color:var(--blue); }
  .icon-links a.gh:hover{ color:var(--text); }

  .role{ color:var(--blue); font-size:14px; font-weight:500; margin-bottom:2px; }
  .loc{ color:var(--muted); font-size:13px; font-family:'JetBrains Mono', monospace; margin-bottom:22px; }

  .email-btn{
    font-size:13px; display:flex; align-items:center; gap:8px; color:var(--text);
    padding:8px 10px; border:1px solid var(--line); border-radius:var(--radius);
    margin-bottom:28px; width:fit-content; transition:border-color .15s, color .15s;
  }
  .email-btn:hover{ border-color:var(--accent); color:var(--accent); }
  .email-btn::before{ content:"›"; color:var(--accent); font-family:monospace; }

  .status-badge{
    border:1px dashed var(--accent-dim); background:rgba(232,163,61,0.06);
    padding:10px 12px; font-size:12.5px; color:var(--accent); font-family:'JetBrains Mono', monospace;
  }
  .status-badge b{ color:var(--text); }

  /* ---------- Top nav ---------- */
  header.topnav{
    position:sticky; top:0; z-index:20; display:flex; align-items:center; gap:28px;
    padding:18px 48px; background:rgba(11,18,32,0.85); backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav-links{ display:flex; align-items:center; gap:24px; margin-right:auto; font-size:14px; }
  .nav-links a{ color:var(--muted); transition:color .15s; }
  .nav-links a:hover, .nav-links a.active{ color:var(--text); }
  .resume-btn{
    display:inline-flex; align-items:center; gap:6px; font-family:'Space Grotesk', sans-serif;
    font-size:13px; font-weight:600; color:var(--accent); border:1px solid var(--accent);
    border-radius:var(--radius); padding:8px 16px; transition:background .15s;
  }
  .resume-btn:hover{ background:rgba(232,163,61,0.1); }

  /* ---------- Main content ---------- */
  main{ padding:56px 64px 100px; position:relative; z-index:1; }
  section{ margin-bottom:88px; scroll-margin-top:24px; }
  .section-label{ font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--accent); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:10px; }
  section h2{ font-size:32px; font-weight:600; margin-bottom:8px; }
  section .subhead{ color:var(--muted); font-size:14.5px; margin-bottom:32px; max-width:640px; }

  .about-body{ max-width:680px; color:#c9d2de; font-size:15px; }
  .about-body p{ margin-bottom:16px; }
  .about-body p:last-child{ margin-bottom:0; }

  /* Projects */
  .project-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:20px; }
  .project-card{
    background:var(--panel); border:1px solid var(--line); border-radius:var(--radius);
    padding:24px; cursor:pointer; transition:transform .15s, border-color .15s;
  }
  .project-card:hover{ transform:translateY(-2px); border-color:var(--accent-dim); }
  .project-card .idx{ font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--accent); margin-bottom:10px; display:block; }
  .project-card h3{ font-size:18px; margin-bottom:8px; }
  .project-card p{ color:var(--muted); font-size:13.5px; margin-bottom:16px; }
  .project-tags{ display:flex; flex-wrap:wrap; gap:6px; margin-bottom:16px; }
  .project-tags span{ font-size:10.5px; font-family:'JetBrains Mono', monospace; color:var(--blue); border:1px solid var(--line); padding:3px 8px; }
  .project-card .view-link{ font-size:12.5px; color:var(--accent); }
  .project-card.placeholder{
    border-style:dashed; color:var(--muted); cursor:default;
    display:flex; align-items:center; justify-content:center;
    font-family:'JetBrains Mono', monospace; font-size:12.5px; min-height:180px; text-align:center; padding:24px;
  }
  .project-card.placeholder:hover{ transform:none; border-color:var(--line); }

  /* Skills */
  .skills-grid{ display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; max-width:820px; }
  .skills-cat{ border:1px solid var(--line); padding:18px 20px; background:var(--panel); }
  .skills-cat .cat-label{ font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--accent); text-transform:uppercase; margin-bottom:12px; letter-spacing:0.08em; }
  .skills-cat ul{ list-style:none; }
  .skills-cat li{ font-size:13.5px; color:#c9d2de; padding:4px 0; border-bottom:1px dotted var(--line); }
  .skills-cat li:last-child{ border-bottom:none; }

  /* Experience */
  .timeline{ max-width:720px; }
  .timeline-item{ display:grid; grid-template-columns:120px 1fr; gap:20px; padding-bottom:28px; border-left:1px solid var(--line); padding-left:24px; margin-left:4px; position:relative; }
  .timeline-item:last-child{ border-left-color:transparent; padding-bottom:0; }
  .timeline-item::before{ content:""; position:absolute; left:-5px; top:2px; width:9px; height:9px; background:var(--bg); border:2px solid var(--accent); border-radius:50%; }
  .timeline-item .date{ font-family:'JetBrains Mono', monospace; font-size:11.5px; color:var(--muted); }
  .timeline-item h3{ font-size:16px; margin-bottom:2px; }
  .timeline-item .org{ color:var(--blue); font-size:13px; margin-bottom:8px; }
  .timeline-item p{ color:#c9d2de; font-size:13.5px; }

  /* Contact */
  .contact-box{ max-width:520px; border:1px solid var(--line); background:var(--panel); padding:32px; }
  .contact-row{ display:flex; justify-content:space-between; align-items:center; padding:14px 0; border-bottom:1px solid var(--line); font-size:14px; }
  .contact-row:last-child{ border-bottom:none; }
  .contact-row .label{ color:var(--muted); font-family:'JetBrains Mono', monospace; font-size:12px; }
  .contact-row a{ color:var(--accent); }
  .contact-row a:hover{ text-decoration:underline; }

  footer{ text-align:center; padding:40px 24px; color:var(--muted); font-size:12px; font-family:'JetBrains Mono', monospace; border-top:1px solid var(--line); position:relative; z-index:1; }

  /* Modal */
  .modal-overlay{
    display:none; position:fixed; inset:0; z-index:50; background:rgba(6,9,18,0.7);
    align-items:center; justify-content:center; padding:32px;
  }
  .modal-overlay.open{ display:flex; }
  .modal-box{ background:var(--panel); border:1px solid var(--line); max-width:840px; width:100%; max-height:88vh; overflow-y:auto; position:relative; }
  .modal-close{
    position:absolute; top:20px; right:20px; z-index:2; background:rgba(11,18,32,0.6);
    border:1px solid var(--line); color:var(--text); width:34px; height:34px;
    cursor:pointer; font-size:18px; line-height:1; border-radius:var(--radius);
  }
  .modal-img{ width:100%; aspect-ratio:16/8; background:var(--panel-2); display:flex; align-items:center; justify-content:center; color:var(--muted); font-family:'JetBrains Mono', monospace; font-size:12.5px; }
  .modal-body{ padding:40px 44px 44px; }
  .modal-body .idx{ font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--accent); margin-bottom:10px; display:block; }
  .modal-body h3{ font-size:30px; margin-bottom:28px; }
  .modal-body h4{ font-size:16px; margin-bottom:10px; }
  .modal-body .detail{ color:#c9d2de; font-size:15px; margin-bottom:28px; max-width:680px; }
  .modal-tags{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:32px; }
  .modal-tags span{ font-size:12px; font-family:'JetBrains Mono', monospace; color:var(--blue); background:rgba(91,155,213,0.1); border:1px solid var(--line); padding:5px 12px; border-radius:var(--radius); }
  .modal-actions{ display:flex; gap:12px; flex-wrap:wrap; }
  .modal-actions a{ display:inline-flex; align-items:center; gap:6px; font-family:'Space Grotesk', sans-serif; font-size:13px; font-weight:600; border-radius:var(--radius); padding:10px 18px; }
  .modal-actions .repo{ color:var(--accent); border:1px solid var(--accent); }
  .modal-actions .repo:hover{ background:rgba(232,163,61,0.1); }
  .modal-actions .writeup{ color:var(--text); border:1px solid var(--line); }
  .modal-actions .writeup:hover{ border-color:var(--muted); }
</style>
