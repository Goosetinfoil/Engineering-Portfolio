<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  // ---- Project data: add new projects here, and a matching placeholder card below ----
  const projects = [
    {
      idx: "01",
      title: "LEGO SPIKE Prime — Autonomous Ring Retrieval",
      summary: "Autonomous robot built to locate and retrieve rings, developed for RIT robotics work.",
      detail: "Built and programmed an autonomous LEGO SPIKE Prime robot to locate a ring using onboard sensors and retrieve it back to a home zone, developed as part of RIT robotics work. The build combined a color/distance sensor for ring detection with a simple decision loop to drive, search, and grab.",
      tags: ["SPIKE Prime", "Sensors", "Autonomy"],
      repo: "#",
      writeup: "#"
    },
    {
      idx: "02",
      title: "ISSEA STEAM 2025 — Ring Stack Robot",
      summary: "Autonomous LEGO robot built to locate and flip a Ring Stack toy, competed in Addis Ababa. Won the MVP award for best overall team performance.",
      detail: "Designed and coded an autonomous LEGO robot for the ISSEA STEAM 2025 competition in Addis Ababa, tasked with locating and flipping a Ring Stack toy using block-based programming. Our team won the MVP award for best overall team performance across the competition.",
      tags: ["Block Coding", "Autonomy", "Competition"],
      repo: "#",
      writeup: "#"
    }
  ];

  const grid = document.getElementById('project-grid');

  projects.forEach((p) => {
    const card = document.createElement('div');
    card.className = 'project-card';
    card.innerHTML = `
      <span class="idx">// ${p.idx}</span>
      <h3>${p.title}</h3>
      <p>${p.summary}</p>
      <div class="project-tags">${p.tags.map(t => `<span>${t}</span>`).join('')}</div>
      <div class="view-link">View details →</div>
    `;
    card.addEventListener('click', () => openModal(p));
    grid.appendChild(card);
  });

  // Placeholder "add a project" cards
  for (let i = 0; i < 2; i++) {
    const ph = document.createElement('div');
    ph.className = 'project-card placeholder';
    ph.textContent = '+ Add your next Arduino / Python / CAD project here';
    grid.appendChild(ph);
  }

  const overlay = document.getElementById('modal-overlay');
  function openModal(p){
    document.getElementById('modal-idx').textContent = '// ' + p.idx;
    document.getElementById('modal-title').textContent = p.title;
    document.getElementById('modal-detail').textContent = p.detail;
    document.getElementById('modal-tags').innerHTML = p.tags.map(t => `<span>${t}</span>`).join('');
    document.getElementById('modal-repo').href = p.repo;
    document.getElementById('modal-writeup').href = p.writeup;
    overlay.classList.add('open');
  }
  function closeModal(){ overlay.classList.remove('open'); }

  document.getElementById('modal-close').addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Highlight active nav link on scroll
  const sections = document.querySelectorAll('main section');
  const navLinks = document.querySelectorAll('.nav-links a');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        navLinks.forEach(l => l.classList.remove('active'));
        const active = document.querySelector(`.nav-links a[href="#${entry.target.id}"]`);
        if (active) active.classList.add('active');
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });
  sections.forEach(s => observer.observe(s));
</script>

</body>
</html>